@startuml
title Đặt và thanh toán đơn hàng

|Customer|
|UI|
|System|
|Payment Service|

|Customer|
start
:Bấm vào "Giỏ\nhàng";

|UI|
:Hiển thị giỏ hàng;

|Customer|
:Bấm "thanh toán";

|System|
:Kiểm tra token;
if () then (Chưa\nđăng nhập)
  |UI|
  :Hiển thị form\nđăng nhập;
  |Customer|
  :Nhập thông tin\nđăng nhập;
else (Đã đăng\nnhập)
endif

|System|
:Kiểm tra tồn kho;
if () then (Không\nđủ số\nlượng)
  |UI|
  :Hiển thị cảnh báo;
  :Hiển thị lại giỏ hàng;
  split
    stop
  split again
    |Customer|
    :Chỉnh lại giỏ hàng;
    stop
  end split
else (Đủ số\nlượng)
  |System|
  :Tạo order;
  :Tạo payment;
  
  |UI|
  :Hiển thị mã qr;
  
  |Customer|
  :Người dùng quét\nmã qr;
  
  |Payment Service|
  :Kiểm tra thanh\ntoán;
  
  |System|
  if () then (Thanh\ntoán thất\nbại)
    |UI|
    :Hiển thị lỗi thanh\ntoán;
    |Customer|
    :Bấm thử lại;
    stop
  else (Thanh toán\nthành công)
    |System|
    fork
      :Trừ kho hàng;
    fork again
      :Cập nhật trạng\nthái order;
    end fork
    
    :Xóa giỏ hàng;
    :Lưu database;
    
    |UI|
    :Hiển thị trang thái\nđơn;
    stop
  endif
endif
@enduml